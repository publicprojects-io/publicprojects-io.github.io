{
	"name": "publicprojects-io.github.io",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"description": "Public Projects: public open source for the global good. A prerendered SvelteKit site on GitHub Pages.",
	"license": "MIT OR Apache-2.0 OR BSD-3-Clause OR GPL-2.0-only OR GPL-3.0-only OR OGL-UK-3.0 OR CC-BY-NC-SA-4.0",
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"themes": "node scripts/copy-themes.mjs",
		"dev": "node scripts/copy-themes.mjs && vite dev",
		"build": "node scripts/copy-themes.mjs && vite build",
		"preview": "vite preview",
		"stats": "node scripts/refresh-stats.mjs",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@lilydesignsystem/svelte-headless": "^0.13.1",
		"@lilydesignsystem/svelte-locale-picker": "^0.3.3",
		"@lilydesignsystem/svelte-picker-bar": "^0.9.0",
		"@lilydesignsystem/svelte-search-picker": "^0.2.2",
		"@lilydesignsystem/svelte-share-picker": "^0.3.2",
		"@lilydesignsystem/svelte-text-size-picker": "^0.3.2",
		"@lilydesignsystem/svelte-theme-picker": "^0.5.0",
		"@lilydesignsystem/themes": "^0.8.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.1",
		"happy-dom": "^21.0.4",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
